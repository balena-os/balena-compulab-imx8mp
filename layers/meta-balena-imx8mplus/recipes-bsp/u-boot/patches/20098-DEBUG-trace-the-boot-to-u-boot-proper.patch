+/*
+ * DEBUG ONLY, remove after the investigation. Trace the boot of U-Boot proper
+ * writing directly to UART2 of the iot-gate-imx8plus, which the SPL leaves set
+ * up. The console is not available until serial_init() and console_init_f(),
+ * and its output has not been readable since then
+ */
+#define DBG_UART2_BASE		0x30890000
+#define DBG_UART2_UTXD		(DBG_UART2_BASE + 0x40)
+#define DBG_UART2_UTS		(DBG_UART2_BASE + 0xb4)
+#define DBG_UART2_UTS_TXFULL	(1 << 4)
+
+void dbg_pb_putc(char c);
+void dbg_pb_puts(const char *s);
+void dbg_pb_hex(ulong v);
+void dbg_pb_console_putc(char c);
+void dbg_pb_console_puts(const char *s);
+void dbg_pb_backtrace(void);
+
+void dbg_pb_putc(char c)
+{
+	unsigned int timeout = 100000;
+
+	while ((readl(DBG_UART2_UTS) & DBG_UART2_UTS_TXFULL) && --timeout)
+		;
+	writel(c, DBG_UART2_UTXD);
+}
+
+void dbg_pb_puts(const char *s)
+{
+	while (*s) {
+		if (*s == '\n')
+			dbg_pb_putc('\r');
+		dbg_pb_putc(*s++);
+	}
+}
+
+void dbg_pb_hex(ulong v)
+{
+	int i;
+
+	for (i = sizeof(ulong) * 8 - 4; i >= 0; i -= 4)
+		dbg_pb_putc("0123456789abcdef"[(v >> i) & 0xf]);
+}
+
+/* What the console is asked to print, to see it whatever its state is */
+void dbg_pb_console_putc(char c)
+{
+	if (c == '\n')
+		dbg_pb_putc('\r');
+	dbg_pb_putc(c);
+}
+
+void dbg_pb_console_puts(const char *s)
+{
+	while (*s)
+		dbg_pb_console_putc(*s++);
+}
+
+/*
+ * The words on the stack that point into the text of U-Boot, as link addresses
+ * (the relocation offset removed) to be looked up in the symbols. They are the
+ * return addresses of the callers, in no guaranteed order, and some may be
+ * stale values left on the stack
+ */
+void dbg_pb_backtrace(void)
+{
+	ulong *sp = (ulong *)__builtin_frame_address(0);
+	ulong off = (gd->flags & GD_FLG_RELOC) ? gd->reloc_off : 0;
+	ulong lo = 0x40200000 + off;
+	ulong hi = lo + 0x140000;
+	int i, n = 0;
+
+	dbg_pb_puts("PB:bt");
+	for (i = 0; i < 256 && n < 24; i++) {
+		if (sp[i] >= lo && sp[i] < hi) {
+			dbg_pb_puts(" 0x");
+			dbg_pb_hex(sp[i] - off);
+			n++;
+		}
+	}
+	dbg_pb_puts("\n");
+}
+
+#define DBG_MARK(name) \
+static int dbg_mark_##name(void) \
+{ \
+	dbg_pb_puts("PB:" #name "\n"); \
+	return 0; \
+}
+
+DBG_MARK(start)
+DBG_MARK(cpu)
+DBG_MARK(dm)
+DBG_MARK(early)
+DBG_MARK(serial)
+
+/*
+ * Does the memory above 2 GB exist? Write two different words 2 GB apart, in
+ * memory that nothing uses yet, and read them back from the memory, not from
+ * the cache. If the second one shows in the first, the two addresses are the
+ * same memory, as in a board with half of the DDR that the SPL trained
+ */
+static int dbg_mark_dram(void)
+{
+	volatile u32 *lo = (volatile u32 *)0x70000000;
+	volatile u32 *hi = (volatile u32 *)0xf0000000;
+	u32 save_lo = *lo, save_hi = *hi;
+
+	*lo = 0x13572468;
+	*hi = 0x24681357;
+	flush_dcache_range((ulong)lo, (ulong)lo + 4);
+	flush_dcache_range((ulong)hi, (ulong)hi + 4);
+	invalidate_dcache_range((ulong)lo, (ulong)lo + 4);
+	invalidate_dcache_range((ulong)hi, (ulong)hi + 4);
+	dbg_pb_puts("PB:dram alias test: 0x70000000 reads 0x");
+	dbg_pb_hex(*lo);
+	dbg_pb_puts(", 0xf0000000 reads 0x");
+	dbg_pb_hex(*hi);
+	dbg_pb_puts(*lo == 0x24681357 ? ": SAME MEMORY, nothing above 2 GB\n" :
+		    ": different memory, 4 GB are there\n");
+	*lo = save_lo;
+	*hi = save_hi;
+	flush_dcache_range((ulong)lo, (ulong)lo + 4);
+	flush_dcache_range((ulong)hi, (ulong)hi + 4);
+	return 0;
+}
+
+/* The state of the console, and whether the version string reads well */
+static int dbg_mark_console(void)
+{
+	dbg_pb_puts("PB:console flags 0x");
+	dbg_pb_hex(gd->flags);
+	dbg_pb_puts(" have_console 0x");
+	dbg_pb_hex((ulong)gd->have_console);
+	dbg_pb_puts(" version [");
+	dbg_pb_puts(version_string);
+	dbg_pb_puts("]\n");
+	return 0;
+}
+
+/* 0xedfe0dd0 read as a word is the magic of a valid FDT */
+static int dbg_mark_fdt(void)
+{
+	dbg_pb_puts("PB:fdt blob 0x");
+	dbg_pb_hex((ulong)gd->fdt_blob);
+	dbg_pb_puts(" word 0x");
+	dbg_pb_hex(*(u32 *)gd->fdt_blob);
+	dbg_pb_puts("\n");
+	return 0;
+}
+
+/* What crt0 uses next: the new stack and gd, and where it relocates to */
+static int dbg_mark_reloc(void)
+{
+	dbg_pb_puts("PB:reloc ram_size 0x");
+	dbg_pb_hex((ulong)gd->ram_size);
+	dbg_pb_puts(" ram_top 0x");
+	dbg_pb_hex((ulong)gd->ram_top);
+	dbg_pb_puts(" relocaddr 0x");
+	dbg_pb_hex(gd->relocaddr);
+	dbg_pb_puts(" start_addr_sp 0x");
+	dbg_pb_hex(gd->start_addr_sp);
+	dbg_pb_puts(" new_gd 0x");
+	dbg_pb_hex((ulong)gd->new_gd);
+	dbg_pb_puts(" reloc_off 0x");
+	dbg_pb_hex(gd->reloc_off);
+	dbg_pb_puts("\n");
+	return 0;
+}
+
