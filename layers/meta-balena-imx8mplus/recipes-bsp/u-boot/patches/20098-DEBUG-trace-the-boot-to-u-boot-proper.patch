--- a/common/board_f.c
+++ b/common/board_f.c
@@ -833,3 +833,67 @@
 
+/*
+ * DEBUG ONLY, remove after the investigation. Trace the init sequence writing
+ * directly to UART2 of the iot-gate-imx8plus, which the SPL leaves set up, as
+ * the console is not available until serial_init() and console_init_f()
+ */
+#define DBG_UART2_BASE		0x30890000
+#define DBG_UART2_UTXD		(DBG_UART2_BASE + 0x40)
+#define DBG_UART2_UTS		(DBG_UART2_BASE + 0xb4)
+#define DBG_UART2_UTS_TXFULL	(1 << 4)
+
+static void dbg_putc(char c)
+{
+	unsigned int timeout = 100000;
+
+	while ((readl(DBG_UART2_UTS) & DBG_UART2_UTS_TXFULL) && --timeout)
+		;
+	writel(c, DBG_UART2_UTXD);
+}
+
+static void dbg_puts(const char *s)
+{
+	while (*s) {
+		if (*s == '\n')
+			dbg_putc('\r');
+		dbg_putc(*s++);
+	}
+}
+
+static void dbg_hex(ulong v)
+{
+	int i;
+
+	for (i = 28; i >= 0; i -= 4)
+		dbg_putc("0123456789abcdef"[(v >> i) & 0xf]);
+}
+
+#define DBG_MARK(name) \
+static int dbg_mark_##name(void) \
+{ \
+	dbg_puts("PB:" #name "\n"); \
+	return 0; \
+}
+
+DBG_MARK(start)
+DBG_MARK(cpu)
+DBG_MARK(dm)
+DBG_MARK(early)
+DBG_MARK(serial)
+DBG_MARK(console)
+DBG_MARK(dram)
+DBG_MARK(reloc)
+
+/* 0xedfe0dd0 read as a word is the magic of a valid FDT */
+static int dbg_mark_fdt(void)
+{
+	dbg_puts("PB:fdt blob 0x");
+	dbg_hex((ulong)gd->fdt_blob);
+	dbg_puts(" word 0x");
+	dbg_hex(*(u32 *)gd->fdt_blob);
+	dbg_puts("\n");
+	return 0;
+}
+
 static const init_fnc_t init_sequence_f[] = {
