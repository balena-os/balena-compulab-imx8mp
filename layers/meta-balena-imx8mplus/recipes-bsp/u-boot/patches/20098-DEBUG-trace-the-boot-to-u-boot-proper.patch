diff --git a/common/board_f.c b/common/board_f.c
--- a/common/board_f.c
+++ b/common/board_f.c
@@ -833,3 +833,106 @@
 
+/*
+ * DEBUG ONLY, remove after the investigation. Trace the boot of U-Boot proper
+ * writing directly to UART2 of the iot-gate-imx8plus, which the SPL leaves set
+ * up. The console is not available until serial_init() and console_init_f(),
+ * and its output has not been readable since then
+ */
+#define DBG_UART2_BASE		0x30890000
+#define DBG_UART2_UTXD		(DBG_UART2_BASE + 0x40)
+#define DBG_UART2_UTS		(DBG_UART2_BASE + 0xb4)
+#define DBG_UART2_UTS_TXFULL	(1 << 4)
+
+void dbg_pb_putc(char c);
+void dbg_pb_puts(const char *s);
+void dbg_pb_hex(ulong v);
+void dbg_pb_console_putc(char c);
+void dbg_pb_console_puts(const char *s);
+
+void dbg_pb_putc(char c)
+{
+	unsigned int timeout = 100000;
+
+	while ((readl(DBG_UART2_UTS) & DBG_UART2_UTS_TXFULL) && --timeout)
+		;
+	writel(c, DBG_UART2_UTXD);
+}
+
+void dbg_pb_puts(const char *s)
+{
+	while (*s) {
+		if (*s == '\n')
+			dbg_pb_putc('\r');
+		dbg_pb_putc(*s++);
+	}
+}
+
+void dbg_pb_hex(ulong v)
+{
+	int i;
+
+	for (i = sizeof(ulong) * 8 - 4; i >= 0; i -= 4)
+		dbg_pb_putc("0123456789abcdef"[(v >> i) & 0xf]);
+}
+
+/* What the console is asked to print, to see it whatever its state is */
+void dbg_pb_console_putc(char c)
+{
+	if (c == '\n')
+		dbg_pb_putc('\r');
+	dbg_pb_putc(c);
+}
+
+void dbg_pb_console_puts(const char *s)
+{
+	while (*s)
+		dbg_pb_console_putc(*s++);
+}
+
+#define DBG_MARK(name) \
+static int dbg_mark_##name(void) \
+{ \
+	dbg_pb_puts("PB:" #name "\n"); \
+	return 0; \
+}
+
+DBG_MARK(start)
+DBG_MARK(cpu)
+DBG_MARK(dm)
+DBG_MARK(early)
+DBG_MARK(serial)
+DBG_MARK(console)
+DBG_MARK(dram)
+
+/* 0xedfe0dd0 read as a word is the magic of a valid FDT */
+static int dbg_mark_fdt(void)
+{
+	dbg_pb_puts("PB:fdt blob 0x");
+	dbg_pb_hex((ulong)gd->fdt_blob);
+	dbg_pb_puts(" word 0x");
+	dbg_pb_hex(*(u32 *)gd->fdt_blob);
+	dbg_pb_puts("\n");
+	return 0;
+}
+
+/* What crt0 uses next: the new stack and gd, and where it relocates to */
+static int dbg_mark_reloc(void)
+{
+	dbg_pb_puts("PB:reloc ram_size 0x");
+	dbg_pb_hex((ulong)gd->ram_size);
+	dbg_pb_puts(" ram_top 0x");
+	dbg_pb_hex((ulong)gd->ram_top);
+	dbg_pb_puts(" relocaddr 0x");
+	dbg_pb_hex(gd->relocaddr);
+	dbg_pb_puts(" start_addr_sp 0x");
+	dbg_pb_hex(gd->start_addr_sp);
+	dbg_pb_puts(" new_gd 0x");
+	dbg_pb_hex((ulong)gd->new_gd);
+	dbg_pb_puts(" reloc_off 0x");
+	dbg_pb_hex(gd->reloc_off);
+	dbg_pb_puts("\n");
+	return 0;
+}
+
 static const init_fnc_t init_sequence_f[] = {
+	dbg_mark_start,
 	setup_mon_len,
@@ -838,2 +941,3 @@
 #endif
