From: guille-vega <guillermo.vega@balena.io>
Subject: DEBUG: Print the FIT hash and the DDR firmware address in the SPL

Temporary, do not merge. Prints what spl_verify_fit_hash() compares and the
address the DDR firmware is read from, to compare how both are computed.

---
 arch/arm/mach-imx/spl.c        | 22 ++++++++++++++++++++++
 drivers/ddr/imx/phy/helper.c   |  7 +++++++
 2 files changed, 29 insertions(+)

diff --git a/arch/arm/mach-imx/spl.c b/arch/arm/mach-imx/spl.c
--- a/arch/arm/mach-imx/spl.c
+++ b/arch/arm/mach-imx/spl.c
@@ -378,6 +378,29 @@
 		return -1;
 	}
 
+	{
+		/* DEBUG ONLY: show what is compared, remove after the investigation */
+		int dbg_i;
+
+		printf("DBG fit=%p size=%lu _end=%p fdt_blob=%p fdt_total=%u fit_hash=0x%lx\n",
+		       fit, size, &_end, gd->fdt_blob,
+		       gd->fdt_blob ? (unsigned int)fdt_totalsize(gd->fdt_blob) : 0,
+		       fit_hash);
+		printf("DBG cfg: sha_hw_accel=%d spl_sha256=%d fsl_caam=%d imx_hab=%d\n",
+		       IS_ENABLED(CONFIG_SHA_HW_ACCEL), IS_ENABLED(CONFIG_SPL_SHA256),
+		       IS_ENABLED(CONFIG_FSL_CAAM), IS_ENABLED(CONFIG_IMX_HAB));
+		printf("DBG fit[0..15]:");
+		for (dbg_i = 0; dbg_i < 16; dbg_i++)
+			printf(" %02x", ((u8 *)fit)[dbg_i]);
+		printf("\nDBG computed:");
+		for (dbg_i = 0; dbg_i < value_len; dbg_i++)
+			printf("%02x", value[dbg_i]);
+		printf("\nDBG stored  :");
+		for (dbg_i = 0; dbg_i < SHA256_SUM_LEN; dbg_i++)
+			printf("%02x", ((u8 *)fit_hash)[dbg_i]);
+		printf("\n");
+	}
+
 	if (value_len != SHA256_SUM_LEN) {
 		printf("Bad hash value len\n");
 		return -1;
diff --git a/drivers/ddr/imx/phy/helper.c b/drivers/ddr/imx/phy/helper.c
--- a/drivers/ddr/imx/phy/helper.c
+++ b/drivers/ddr/imx/phy/helper.c
@@ -60,6 +60,13 @@
 
 	dmem_start = imem_start + imem_len;
 
+	/* DEBUG ONLY: where the DDR firmware is read from, remove after the investigation */
+	if (type == FW_1D_IMAGE)
+		printf("DBG ddr fw: _end=%p fdt_blob=%p fdt_total=%u imem=0x%lx binman_syms_ok=%d\n",
+		       &_end, gd->fdt_blob,
+		       gd->fdt_blob ? (unsigned int)fdt_totalsize(gd->fdt_blob) : 0,
+		       imem_start, (int)BINMAN_SYMS_OK);
+
 	if (BINMAN_SYMS_OK) {
 		switch (type) {
 		case FW_1D_IMAGE:
