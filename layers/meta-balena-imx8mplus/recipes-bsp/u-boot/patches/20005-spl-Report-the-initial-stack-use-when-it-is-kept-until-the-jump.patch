From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: guille-vega <guillermo.vega@balena.io>
Date: Mon, 2 Nov 2026 08:36:04 +0100
Subject: spl: Report the initial stack use when it is kept until the
 jump

SPL_SYS_REPORT_STACK_F_USAGE reports how much of the initial stack the
SPL has used when it moves to the SPL_STACK_R one. Without SPL_STACK_R
the SPL runs on the initial stack until it jumps to the next image, and
it is not reported.

Report it before the jump, and before a panic, as the SPL may fail on
that stack.

Signed-off-by: guille-vega <guillermo.vega@balena.io>
---
 common/spl/spl.c | 5 +++++
 include/spl.h    | 8 ++++++++
 lib/panic.c      | 8 ++++++++
 3 files changed, 21 insertions(+)

diff --git a/common/spl/spl.c b/common/spl/spl.c
index d9736d3..ea202ae 100644
--- a/common/spl/spl.c
+++ b/common/spl/spl.c
@@ -914,6 +914,11 @@ void board_init_r(gd_t *dummy1, ulong dummy2)
 		debug("Failed to stash bootstage: err=%d\n", ret);
 #endif
 
+	/* Without SPL_STACK_R the initial stack is kept until the jump */
+	if (CONFIG_IS_ENABLED(SYS_REPORT_STACK_F_USAGE) &&
+	    !IS_ENABLED(CONFIG_SPL_STACK_R))
+		spl_relocate_stack_check();
+
 	spl_board_prepare_for_boot();
 	jump_to_image_no_args(&spl_image);
 }
diff --git a/include/spl.h b/include/spl.h
index da90ab6..910ed23 100644
--- a/include/spl.h
+++ b/include/spl.h
@@ -515,6 +515,14 @@ void spl_board_prepare_for_linux(void);
  */
 void spl_board_prepare_for_optee(void *fdt);
 void spl_board_prepare_for_boot(void);
+
+/**
+ * spl_relocate_stack_check() - Report the use of the initial stack
+ *
+ * With SPL_SYS_REPORT_STACK_F_USAGE, print how much of the initial stack,
+ * SPL_SIZE_LIMIT_PROVIDE_STACK, has been used.
+ */
+void spl_relocate_stack_check(void);
 int spl_board_ubi_load_image(u32 boot_device);
 int spl_board_boot_device(u32 boot_device);
 
diff --git a/lib/panic.c b/lib/panic.c
index 66ae17f..9dffd3e 100644
--- a/lib/panic.c
+++ b/lib/panic.c
@@ -14,14 +14,22 @@
 #if !defined(CONFIG_PANIC_HANG)
 #include <command.h>
 #endif
+#include <asm/global_data.h>
 #include <linux/delay.h>
+#include <spl.h>
 #include <stdio.h>
 
+DECLARE_GLOBAL_DATA_PTR;
+
 static void panic_finish(void) __attribute__ ((noreturn));
 
 static void panic_finish(void)
 {
 	putc('\n');
+	/* Without SPL_STACK_R the SPL may fail on its initial stack */
+	if (CONFIG_IS_ENABLED(SYS_REPORT_STACK_F_USAGE) &&
+	    !IS_ENABLED(CONFIG_SPL_STACK_R) && gd->start_addr_sp)
+		spl_relocate_stack_check();
 #if defined(CONFIG_PANIC_HANG)
 	hang();
 #else
